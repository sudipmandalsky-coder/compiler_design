{"cells":[{"cell_type":"code","source":["\n","class ASTNode:\n","    def __init__(self, value):\n","        self.value = value\n","        self.left = None\n","        self.right = None\n","\n","tokens = input(\"Enter expression (e.g., a + b): \").split()\n","\n","if len(tokens) == 3:\n","    root = ASTNode(tokens[1])      # Operator\n","    root.left = ASTNode(tokens[0]) # Left operand\n","    root.right = ASTNode(tokens[2])# Right operand\n","\n","    print(\"\\nAbstract Syntax Tree\")\n","    print(\"        \", root.value)\n","    print(\"       / \\\\\")\n","    print(\"     \", root.left.value, \" \", root.right.value)\n","\n","else:\n","    print(\"Invalid expression format.\")\n"],"metadata":{"id":"NKNKqAUQh2-9","executionInfo":{"status":"ok","timestamp":1789366176593,"user_tz":-330,"elapsed":43779,"user":{"displayName":"","userId":""}},"outputId":"d0166560-a120-4a56-e5af-4ecce2a54017","colab":{"base_uri":"https://localhost:8080/"}},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Enter expression (e.g., a + b): a * b\n","\n","Abstract Syntax Tree\n","         *\n","       / \\\n","      a   b\n"]}]},{"cell_type":"code","source":["class Node:\n","    def __init__(self, value, left=None, right=None):\n","        self.value = value\n","        self.left = left\n","        self.right = right\n","\n","\n","def evaluate(node):\n","    if node.left is None and node.right is None:\n","        print(\"Leaf node:\", node.value)\n","        return node.value\n","\n","    left_value = evaluate(node.left)\n","    right_value = evaluate(node.right)\n","\n","    if node.value == '+':\n","        node.result = left_value + right_value\n","    elif node.value == '-':\n","        node.result = left_value - right_value\n","    elif node.value == '*':\n","        node.result = left_value * right_value\n","    elif node.value == '/':\n","        node.result = left_value / right_value\n","\n","    print(\"Node\", node.value, \"=\", node.result)\